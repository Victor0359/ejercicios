<body>
  <h1>Actualización de Contratos</h1>

  <form method="GET" action="/actualizacion_contratos"></form>

  <h2><%= monthNames %> <%= year %></h2>
  <h3>📋 Contratos a actualizar este mes</h3>

  <% if (contratosMes.length > 0) { %>
  <ul>
    <% contratosMes.forEach(c => { %>
    <li>
      <strong>Propiedad:</strong> <%= c.direccion %> |
      <strong>Inicio:</strong> |<%= new
      Date(c.fecha_inicio).toLocaleDateString('es-AR', { year: 'numeric', month:
      'numeric', day: 'numeric' }) %>| <strong>Frecuencia:</strong> cada <%=
      c.frecuencia %> meses
    </li>
    <% }) %>
  </ul>
  <% } else { %>
  <p>No hay contratos que deban actualizarse este mes.</p>
  <% } %>

  <link rel="stylesheet" href="/css/Actualización_contratos.css" />
</body>
